# News API Keys
# Get your free API keys from the following sources:
# - NewsAPI: https://newsapi.org/register
# - The Guardian: https://open-platform.theguardian.com/access/
# - New York Times: https://developer.nytimes.com/get-started

VITE_NEWSAPI_KEY=your_newsapi_key_here
VITE_GUARDIAN_KEY=your_guardian_key_here
VITE_NYTIMES_KEY=your_nytimes_key_here

# Set to "true" to use mock data instead of real APIs (useful for development without API keys)
VITE_USE_MOCK_DATA=false
